SELECT COUNT(order_id) AS total_orders 
FROM orders2;


SELECT status, COUNT(order_id) AS order_count 
FROM orders2 
GROUP BY status;


SELECT * FROM orders2 
ORDER BY order_date DESC 
LIMIT 10;


SELECT order_id, SUM(quantity * unit_price) AS total_amount
FROM order_items
GROUP BY order_id
ORDER BY total_amount DESC
LIMIT 10;

SELECT order_date, COUNT(order_id) AS orders_per_day
FROM orders2
GROUP BY order_date
ORDER BY order_date ASC;



SELECT DATE_FORMAT(order_date, '%Y-%m') AS order_month, COUNT(order_id) AS total_orders
FROM orders2
GROUP BY order_month
ORDER BY total_orders DESC;

SELECT ROUND(AVG(order_total), 2) AS average_order_value 
FROM (
    SELECT order_id, SUM(quantity * unit_price) AS order_total 
    FROM order_items 
    GROUP BY order_id
) AS calculated_totals;



SELECT c.customer_id, c.full_name, COUNT(o.order_id) AS order_count
FROM customers c
JOIN orders2 o ON c.customer_id = o.customer_id
GROUP BY c.customer_id, c.full_name
ORDER BY order_count DESC
LIMIT 10;
